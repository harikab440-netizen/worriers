# ========================================================
# Campus Lost & Found Environment Variables Configuration
# ========================================================

# --------------------------------------------------------
# Frontend Client Variables (Exposed to browser via Vite)
# --------------------------------------------------------
# Base URL for the Express backend API
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Supabase Project URL (Public)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Client Key (Public - safe for client-side usage with RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --------------------------------------------------------
# Backend Server Variables (CRITICAL: NEVER EXPOSE TO CLIENT)
# --------------------------------------------------------
# HTTP server port
PORT=4000

# Environment mode ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS client origin (frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# Supabase Project URL (Server-side)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (Server-side fallback)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-ONLY: full bypass of RLS for administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string (Server-only for running migrations directly if needed)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Google Gemini API Key (SERVER-ONLY: Never leak to frontend!)
# Official Google GenAI SDK (@google/genai)
GEMINI_API_KEY=your-gemini-api-key

# Gemini Model name (Defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
